      <div class="status-row"><span class="status-lbl">Publisher Prefix</span><span class="status-val">dodbl_</span></div>
      <div class="status-row"><span class="status-lbl">Cloud</span><span class="status-val">GCC High &middot; IL4/IL5</span></div>
      <div class="status-row"><span class="status-lbl">PCF Control</span><span class="status-val">DoDBannerLibrary.DodBannerControl v1.2.1 &nbsp;<span class="badge-green">Active</span></span></div>
      <div class="status-row"><span class="status-lbl">Consent Cookie</span><span class="status-val" id="cookieStatus">Checking&hellip;</span></div>
    </div>

  </div>
</div>

<script>
"use strict";

// ── Document target ──────────────────────────────────────────────────────────
// Use window.top.document so the consent cookie is shared with dodbl_dodbanner.js
// which also reads window.top.document.cookie from inside the form iframe.
var _doc;
try { _doc = (window.top && window.top.document) ? window.top.document : document; }
catch (_e) { _doc = document; }

// ── Cookie helpers ───────────────────────────────────────────────────────────
var COOKIE_NAME  = "dodbl_Accepted";
var EXPIRY_DAYS  = 30;
var CONSENT_TEXT_SCHEMA = "dodbl_DoDConsentText";
var CONSENT_WARNING_PREFIX = "WARNING:";
var BANNER_TYPE_DEFAULT = "";
var _bannerEnvVars = {};
var _consentTextShown = "";
var CONSENT_TEXT_DEFAULT =
  "WARNING: This is a U.S. Government computer system, which may be accessed " +
  "and used only for authorized Government business by authorized personnel. " +
  "Unauthorized access or use of this computer system may subject violators to " +
  "criminal, civil, and/or administrative action. All information on this system " +
  "may be intercepted, recorded, read, copied, and disclosed by and to authorized " +
  "personnel for official purposes, including criminal investigations. Such " +
  "information includes sensitive data encrypted to comply with confidentiality " +
  "and privacy requirements. Access or use of this computer system by any person, " +
  "whether authorized or unauthorized, constitutes consent to these terms. " +
  "There is no right of privacy in this system.";
_consentTextShown = CONSENT_TEXT_DEFAULT;

function setCookie(name, value, days) {
  try {
    var exp = new Date();
    exp.setTime(exp.getTime() + days * 24 * 60 * 60 * 1000);
    _doc.cookie = name + "=" + value + ";expires=" + exp.toUTCString() + ";path=/; Secure; SameSite=Strict";
  } catch (_e) { /* cross-origin guard */ }
}

function getCookie(name) {
  try {
    var prefix = name + "=";
    var parts  = _doc.cookie.split(";");       // split BEFORE decoding — guards URIError
    for (var i = 0; i < parts.length; i++) {
      var c = parts[i].trimStart();
      if (c.indexOf(prefix) === 0) {
        try { return decodeURIComponent(c.substring(prefix.length)); }
        catch (_e) { return c.substring(prefix.length); }
      }
    }
  } catch (_e) { /* cookie access blocked */ }
  return "";
}

function getXrm() {
  try {
    return (parent && parent.Xrm) ? parent.Xrm : null;
  } catch (_e) {
    return null;
  }
}

function getQueryValue(name) {
  try {
    var params = new URLSearchParams(window.location.search || "");
    var value = params.get(name);
    if (value) return value;

    var data = params.get("data");
    if (!data) return "";

    var dataParams = new URLSearchParams(data);
    return dataParams.get(name) || "";
  } catch (_e) {
    return "";
  }
}

function getConsentTextOverride() {
  var queryText = getQueryValue(CONSENT_TEXT_SCHEMA) || getQueryValue("consentText");
  if (queryText && queryText.trim()) {
    return Promise.resolve(queryText);
  }

  try {
    var xrm = getXrm();
    if (!(xrm && xrm.WebApi)) {
      return Promise.resolve("");
    }

    return xrm.WebApi.retrieveMultipleRecords(
      "environmentvariabledefinition",
      "?$select=environmentvariabledefinitionid,defaultvalue&$filter=schemaname eq '" + CONSENT_TEXT_SCHEMA + "'"
    ).then(function (defResult) {
      if (!defResult.entities || defResult.entities.length === 0) return "";

      var def = defResult.entities[0];
      var defaultValue = def.defaultvalue || "";
      return xrm.WebApi.retrieveMultipleRecords(
        "environmentvariablevalue",
        "?$select=value&$filter=_environmentvariabledefinitionid_value eq " + def.environmentvariabledefinitionid
      ).then(function (valResult) {
        if (valResult.entities && valResult.entities.length > 0 && valResult.entities[0].value != null) {
          return valResult.entities[0].value;
        }
        return defaultValue;
      });
    }).catch(function () {
      return "";
    });
  } catch (_e) {
    return Promise.resolve("");
  }
}

function applyConsentText(consentText) {
  var text = (consentText && consentText.trim()) ? consentText : CONSENT_TEXT_DEFAULT;
  var labelEl = document.getElementById("consentWarningLabel");
  var bodyEl = document.getElementById("consentTextBody");
  if (labelEl && bodyEl) {
    if (text.indexOf(CONSENT_WARNING_PREFIX) === 0) {
      labelEl.textContent = CONSENT_WARNING_PREFIX;
      labelEl.style.display = "inline";
      bodyEl.textContent = text.substring(CONSENT_WARNING_PREFIX.length).trimStart();
    } else {
      labelEl.style.display = "none";
      bodyEl.textContent = text;
    }
  }
  _consentTextShown = text;
  return text;
}

function getConsentAuditExpiryDays(value) {
  var days = parseInt(value, 10);
  return (isNaN(days) || days < 0) ? 1 : days;
}

function getBannerTypeChoiceValue(bannerType) {
  var t = ((bannerType || "") + "").trim().toUpperCase();
  if (t === "DOD" || t.indexOf("DOD") >= 0) return 703870001;
  if (t.indexOf("CU") === 0) return 703870002;
  if (t === "U" || t.indexOf("UNCLASSIFIED") === 0) return 703870003;
  if (t.indexOf("CO") === 0) return 703870004;
  if (t.indexOf("S") === 0) return 703870005;
  if (t.indexOf("T") === 0) return 703870006;
  return 703870007;
}

function warnConsentAudit(message) {
  if (window.console && console.warn) console.warn("[DoDBannerLibrary] " + message);
}

function writeConsentRecord() {
  return getBannerEnvVars()
    .then(function (vars) {
      var xrm = getXrm();
      if (!(xrm && xrm.WebApi && xrm.Utility)) {
        warnConsentAudit("Consent audit write skipped: Xrm WebApi unavailable.");
        return;
      }

      var bannerType = ((_bannerEnvVars["dodbl_BannerType"] != null
        ? _bannerEnvVars["dodbl_BannerType"]
        : vars["dodbl_BannerType"]) || BANNER_TYPE_DEFAULT) + "";
      var bannerTypeValue = getBannerTypeChoiceValue(bannerType);
      if (bannerTypeValue === 703870007) {
        warnConsentAudit("Consent audit writing Unspecified banner type.");
      }

      var expiryDays = getConsentAuditExpiryDays(_bannerEnvVars["dodbl_ConsentExpiryDays"] != null
        ? _bannerEnvVars["dodbl_ConsentExpiryDays"]
        : vars["dodbl_ConsentExpiryDays"]);
      var now = new Date();
      var expiry = new Date(now.getTime() + expiryDays * 24 * 60 * 60 * 1000);
      var userId = xrm.Utility.getGlobalContext().userSettings.userId.replace(/[{}]/g, "");
      if (!userId) {
        warnConsentAudit("Consent audit write skipped: current user id unavailable.");
        return;
      }

      return xrm.WebApi.createRecord("dodbl_consentrecord", {
        "dodbl_userid@odata.bind": "/systemusers(" + userId + ")",
        dodbl_bannertype: bannerTypeValue,
        dodbl_acknowledgedon: now.toISOString(),
        dodbl_expirydate: expiry.toISOString(),
        dodbl_consenttext: _consentTextShown || CONSENT_TEXT_DEFAULT,
        dodbl_revoked: false
      });
    })
    .catch(function (e) {
      warnConsentAudit("Consent audit write failed: " + (e && e.message ? e.message : e));
      throw e;
    });
}

// ── Classification bar ───────────────────────────────────────────────────────
// Mirrors dodbl_dodbanner.injectClassificationBar/getEnvVars so the launch page
// and form OnLoad web resource dedupe and render the same shell-level bar.
function getBannerEnabledValue(value) {
  return String(value == null ? "yes" : value).trim().toLowerCase() || "yes";
}

function isBannerEnabled(value) {
  var enabled = getBannerEnabledValue(value);
  return !(enabled === "no" || enabled === "false" || enabled === "0");
}

function isBannerDebugEnabled() {
  try {
    var storage = (window.top && window.top.localStorage) ? window.top.localStorage : window.localStorage;
    return storage && storage.getItem("dodbl_debugBanner") === "true";
  } catch (_e) {
    return false;
  }
}

function logBannerDebug(vars, enabled) {
  if (!isBannerDebugEnabled() || !window.console || !console.log) return;
  console.log("[DoDBannerLibrary] classification bar env", {
    vars: vars,
    enabled: enabled,
    willRender: isBannerEnabled(vars["dodbl_BannerEnabled"])
  });
}

function getClassificationColor(bannerType) {
  var t = (bannerType || "").toUpperCase();
  if (t.indexOf("CU") === 0) return "#5a04b0";  // CUI → purple
  if (t.indexOf("U")  === 0) return "#5cb85c";  // UNCLASSIFIED → green
  if (t.indexOf("CO") === 0) return "#286090";  // CONFIDENTIAL → blue
  if (t.indexOf("S")  === 0) return "#d9534f";  // SECRET → red
  if (t.indexOf("T")  === 0) return "#f0ad4e";  // TOP SECRET → orange
  return "#5e5e5e";                             // unknown → grey
}

function normalizeHexColor(value) {
  var color = ((value || "") + "").trim();
  return /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(color) ? color : "";
}

function getContrastTextColor(hexColor) {
  var color = normalizeHexColor(hexColor);
  if (!color) return "#fff";
  var h = color.substring(1);
  if (h.length === 3) h = h.charAt(0) + h.charAt(0) + h.charAt(1) + h.charAt(1) + h.charAt(2) + h.charAt(2);
  var r = parseInt(h.substring(0, 2), 16);
  var g = parseInt(h.substring(2, 4), 16);
  var b = parseInt(h.substring(4, 6), 16);
  return ((r * 299 + g * 587 + b * 114) / 1000) > 160 ? "#000" : "#fff";
}

function updateDisplayedVersion(version) {
  var value = ((version || "") + "").trim() || "unknown";
  var badge = document.getElementById("appVersionBadge");
  var status = document.getElementById("solutionVersionValue");
  if (badge) badge.textContent = value === "unknown" ? "vunknown" : "v" + value.replace(/^v/i, "");
  if (status) status.textContent = value;
}

function getClassificationLabel(bannerType) {
  var t = (bannerType || "").toUpperCase();
  if (t.indexOf("CU") === 0) return "CUI";
  if (t.indexOf("U")  === 0) return "UNCLASSIFIED";
  if (t.indexOf("CO") === 0) return "CONFIDENTIAL";
  if (t.indexOf("S")  === 0) return "SECRET";
  if (t.indexOf("T")  === 0) return "TOP SECRET";
  if (t.indexOf("DOD") === 0) return "DOD";
  return t;
}

function removeClassificationBars() {
  var shiftedHeader = _doc.querySelector("[data-dodbl-shifted]");
  if (shiftedHeader) {
    try {
      var _saved = JSON.parse(shiftedHeader.getAttribute("data-dodbl-shifted"));
      shiftedHeader.style.top       = _saved.top       || "";
      shiftedHeader.style.marginTop = _saved.marginTop || "";
    } catch (_e) {
      shiftedHeader.style.top = shiftedHeader.style.marginTop = "";
    }
    shiftedHeader.removeAttribute("data-dodbl-shifted");
  }
  _doc.querySelectorAll("[data-dodbl-bar]").forEach(function (el) {
    if (el.parentNode) el.parentNode.removeChild(el);
  });
}

function injectClassificationBar(bannerType, position, bannerColorOverride) {
  var BAR_HEIGHT = 28;

  // ── Cleanup — restore any previously shifted MDA header, then remove old bars
  removeClassificationBars();

  var pos   = ((position || "bottom") + "").trim().toLowerCase();
  var overrideColor = normalizeHexColor(bannerColorOverride);
  var color = overrideColor || getClassificationColor(bannerType);
  var textColor = overrideColor ? getContrastTextColor(overrideColor) : "#fff";
  var label = getClassificationLabel(bannerType);

  function buildBar(placement) {
    var bar = _doc.createElement("div");
    bar.setAttribute("data-dodbl-bar", placement);
    bar.textContent              = label;
    bar.style.position           = "fixed";
    bar.style.left               = "0";
    bar.style.width              = "100%";
    bar.style.height             = BAR_HEIGHT + "px";
    bar.style.backgroundColor    = color;
    bar.style.color              = textColor;
    bar.style.fontWeight         = "bold";
    bar.style.fontFamily         = '"Segoe UI",Tahoma,Geneva,Verdana,sans-serif';
    bar.style.fontSize           = "14px";
    bar.style.display            = "flex";
    bar.style.alignItems         = "center";
    bar.style.justifyContent     = "center";
    bar.style.letterSpacing      = "0.06em";
    bar.style.textShadow         = "1px 1px 0 rgba(0,0,0,.3)";
    bar.style.zIndex             = "9999";
    bar.style.boxSizing          = "border-box";
    bar.style.pointerEvents      = "none"; // informational only — clicks pass through
    if (placement === "top") {
      bar.style.top    = "0";
    } else {
      bar.style.bottom = "0";
    }
    return bar;
  }

  function shiftMdaHeader() {
    // Find the global nav bar: must be near the top of the viewport and span
    // at least half its width.  Explicit MDA selectors come first so we don't
    // accidentally match a <header> inside a form section or card.
    var win = (window.top && window.top.document) ? window.top : window;
    var vw  = win.innerWidth || 800;
    var sels = ["[role='banner']", "[data-id='navbar']", ".pa-n-w", ".pa-navbar", "header"];
    var header = null;
    for (var si = 0; si < sels.length; si++) {
      var _el = _doc.querySelector(sels[si]);
      if (!_el) continue;
      var _r = _el.getBoundingClientRect();
      if (_r.top <= 10 && _r.width >= vw * 0.5) { header = _el; break; }
    }
    if (!header || header.hasAttribute("data-dodbl-shifted")) return;

    // Preserve original inline styles for exact restoration.
    header.setAttribute("data-dodbl-shifted", JSON.stringify({
      top: header.style.top, marginTop: header.style.marginTop
    }));

    var cs = win.getComputedStyle(header);
    if (cs.position === "fixed" || cs.position === "sticky" || cs.position === "absolute") {
      // Positioned element — adjust top offset
      header.style.top = (parseInt(cs.top) || 0) + BAR_HEIGHT + "px";
    } else {
      // Static / relative in document flow — use marginTop to push it down
      header.style.marginTop = (parseInt(cs.marginTop) || 0) + BAR_HEIGHT + "px";
    }
  }

  if (pos === "both") {
    _doc.body.insertBefore(buildBar("top"), _doc.body.firstChild);
    _doc.body.appendChild(buildBar("bottom"));
    shiftMdaHeader();
    setTimeout(shiftMdaHeader, 800);  // retry — MDA may finish rendering after onFormLoad
  } else if (pos === "top") {
    _doc.body.insertBefore(buildBar("top"), _doc.body.firstChild);
    shiftMdaHeader();
    setTimeout(shiftMdaHeader, 800);  // retry — MDA may finish rendering after onFormLoad
  } else {
    _doc.body.appendChild(buildBar("bottom")); // default
  }
}

function getBannerEnvVars() {
  var schemas = [
    "dodbl_BannerEnabled",
    "dodbl_BannerType",
    "dodbl_BannerColor",
    "dodbl_BannerVersion",
    "dodbl_BannerPosition",
    "dodbl_ConsentExpiryDays"
  ];
  var schemaFilter = schemas
    .map(function (s) { return "schemaname eq '" + s + "'"; })
    .join(" or ");

  try {
    var xrm = getXrm();
    if (!(xrm && xrm.WebApi)) {
      return Promise.resolve({});
    }

    return xrm.WebApi.retrieveMultipleRecords(
      "environmentvariabledefinition",
      "?$select=environmentvariabledefinitionid,schemaname,defaultvalue&$filter=" + schemaFilter
    ).then(function (defResult) {
      var defMap = {};
      defResult.entities.forEach(function (def) {
        defMap[def.environmentvariabledefinitionid] = {
          schemaname:   def.schemaname,
          resolvedValue: def.defaultvalue
        };
      });

      var defIds = Object.keys(defMap);
      if (defIds.length === 0) return {};

      var valFilter = defIds
        .map(function (id) { return "_environmentvariabledefinitionid_value eq " + id; })
        .join(" or ");

      return xrm.WebApi.retrieveMultipleRecords(
        "environmentvariablevalue",
        "?$select=value,_environmentvariabledefinitionid_value&$filter=" + valFilter
      ).then(function (valResult) {
        // Per-environment values override the definition defaults
        valResult.entities.forEach(function (val) {
          var defId = val["_environmentvariabledefinitionid_value"];
          if (defMap[defId] && val.value != null && String(val.value).trim() !== "") {
            defMap[defId].resolvedValue = val.value;
          }
        });

        var vars = {};
        Object.keys(defMap).forEach(function (id) {
          vars[defMap[id].schemaname] = defMap[id].resolvedValue;
        });
        return vars;
      });
    });
  } catch (_e) {
    return Promise.resolve({});
  }
}

function renderClassificationBarFromVars(vars) {
  _bannerEnvVars = vars || {};
  updateDisplayedVersion(vars["dodbl_BannerVersion"]);
  var enabled = getBannerEnabledValue(vars["dodbl_BannerEnabled"]);
  logBannerDebug(vars, enabled);
  if (!isBannerEnabled(vars["dodbl_BannerEnabled"])) {
    removeClassificationBars();
    return;
  }

  var bannerType = ((vars["dodbl_BannerType"] || BANNER_TYPE_DEFAULT) + "").trim();
  var bannerColor = ((vars["dodbl_BannerColor"] || "") + "").trim();
  var barPosition = ((vars["dodbl_BannerPosition"] || "Bottom") + "").trim();

  // Classification bar — driven by dodbl_BannerType; position by dodbl_BannerPosition
  if (bannerType) {
    injectClassificationBar(bannerType, barPosition, bannerColor);
  } else {
    removeClassificationBars();
  }
}

function refreshClassificationBar() {
  return getBannerEnvVars()
    .then(function (vars) {
      renderClassificationBarFromVars(vars || {});
      return vars || {};
    })
    .catch(function () {
      _bannerEnvVars = {};
      // Env vars unavailable — leave the launch page unchanged.
    });
}

function renderClassificationBar() {
  return refreshClassificationBar();
}

function exposeClassificationBarRefresh() {
  try {
    var target = (window.top && window.top.document) ? window.top : window;
    target.dodblRenderClassificationBar = refreshClassificationBar;
  } catch (_e) { /* cross-origin guard */ }
}

// ── Navigation ───────────────────────────────────────────────────────────────
function navTo(type, name) {
  try {
    if (type === "webresource") {
      parent.Xrm.Navigation.navigateTo(
        { pageType: "webresource", webresourceName: name },
        { target: 1 }
      );
    } else if (type === "custom") {
      parent.Xrm.Navigation.navigateTo(
        { pageType: "custom", name: name },
        { target: 1 }
      );
    }
  } catch (_e) { /* Xrm unavailable — standalone view, no-op */ }
}

// ── Acknowledge ───────────────────────────────────────────────────────────────
function revealHomeContent(skipFade) {
  var overlay = document.getElementById("consentOverlay");
  var home    = document.getElementById("homeContent");

  if (home) {
    home.style.display = "block";
  }

  if (!overlay) return;
  if (skipFade || overlay.style.display === "none") {
    overlay.style.display = "none";
    overlay.style.opacity = "";
    return;
  }

  var start = null;
  requestAnimationFrame(function step(ts) {
    if (!start) start = ts;
    var p = Math.min((ts - start) / 250, 1);
    overlay.style.opacity = String(1 - p);
    if (p < 1) {
      requestAnimationFrame(step);
    } else {
      overlay.style.display = "none";
      overlay.style.opacity = "";
    }
  });
}

function onAcknowledge() {
  writeConsentRecord()
    .then(function () {
      // Skipped audit paths resolve so standalone previews can remember dismissal;
      // actual write failures reject and leave the cookie unset for retry on next load.
      setCookie(COOKIE_NAME, "Yes", EXPIRY_DAYS);
    })
    .catch(function () {
      // Leave the cookie unset so the next load retries the audit write.
    })
    .then(function () {
      revealHomeContent(false);
      updateCookieStatus();
    });
}

// ── Cookie status indicator ───────────────────────────────────────────────────
function updateCookieStatus() {
  var el = document.getElementById("cookieStatus");
  if (!el) return;
  if (getCookie(COOKIE_NAME) === "Yes") {
    el.innerHTML = 'Acknowledged &nbsp;<span class="badge-green">Active</span>';
  } else {
    el.innerHTML = 'Not set &nbsp;<span class="badge-warn">Pending</span>';
  }
}

// ── Init ─────────────────────────────────────────────────────────────────────
(function init() {
  exposeClassificationBarRefresh();
  renderClassificationBar();

  if (getCookie(COOKIE_NAME) === "Yes") {
    revealHomeContent(true);
    updateCookieStatus();
    return;
  }

  document.getElementById("consentBtn").addEventListener("click", onAcknowledge);

  getConsentTextOverride()
    .then(function (consentText) {
      if (getCookie(COOKIE_NAME) === "Yes") return;
      // 2026-07-24 UAT decision: the launch-page overlay is the single consent
      // entry point. Do not duplicate it with a shell-level global notification.
      applyConsentText(consentText);
    })
    .catch(function () {
      if (getCookie(COOKIE_NAME) === "Yes") return;
      applyConsentText("");
    });

  updateCookieStatus();
}());
</script>
