<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DoD Banner Library &mdash; Release Notes</title>
  <style>
    :root {
      --primary:        #1b3a6b;
      --primary-light:  #e8edf5;
      --success-border: #c3e6c3;
      --warning-border: #fde7a0;
      --error-border:   #f3c6c7;
      --bg:             #f3f2f1;
      --surface:        #ffffff;
      --border:         #edebe9;
      --text:           #323130;
      --text-secondary: #605e5c;
      --text-disabled:  #a19f9d;
      --radius:         4px;
      --shadow:         0 1.6px 3.6px rgba(0,0,0,.13), 0 .3px .9px rgba(0,0,0,.11);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; font-size: 14px; line-height: 1.6; color: var(--text); background: var(--bg); min-height: 100vh; }
    .app-header { background: var(--primary); color: #fff; padding: 18px 32px; display: flex; align-items: center; gap: 16px; }
    .app-header-icon { width: 40px; height: 40px; background: rgba(255,255,255,.18); border-radius: var(--radius); display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }
    .app-header h1 { font-size: 18px; font-weight: 600; }
    .app-header p  { font-size: 12px; opacity: .85; margin-top: 2px; }
    .back-link { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; margin: 20px 32px 0; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); font-size: 12px; color: var(--text-secondary); text-decoration: none; box-shadow: var(--shadow); }
    .back-link:hover { color: var(--primary); background: var(--primary-light); }
    .main { width: 100%; max-width: 960px; margin: 0 auto; padding: 24px 24px 48px; }
    .version-block { margin-bottom: 32px; }
    .version-header { display: flex; align-items: baseline; gap: 16px; padding-bottom: 10px; border-bottom: 2px solid var(--border); margin-bottom: 16px; }
    .version-tag { font-size: 20px; font-weight: 700; color: var(--text); font-family: 'Cascadia Code','Consolas',monospace; }
    .version-date { font-size: 13px; color: var(--text-secondary); }
    .version-badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: 700; background: var(--success-border); color: #0e5a0e; margin-left: auto; }
    .change-group { margin-bottom: 16px; }
    .change-group-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-disabled); margin-bottom: 8px; }
    .change-list { list-style: none; display: flex; flex-direction: column; gap: 6px; }
    .change-item { display: flex; gap: 12px; align-items: flex-start; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 14px; box-shadow: var(--shadow); font-size: 13px; }
    .change-pill { flex-shrink: 0; padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 700; margin-top: 1px; }
    .pill-new    { background: #dce9f8; color: #004578; }
    .pill-note   { background: var(--warning-border); color: #8a6d00; }
    .pill-remove { background: var(--error-border); color: #6b0c0e; }
    .change-text { color: var(--text-secondary); flex: 1; }
    .change-text strong { color: var(--text); }
    code { font-family: 'Cascadia Code','Consolas',monospace; font-size: 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 3px; padding: 1px 5px; color: #005a9e; }
  </style>
</head>
<body>

<div class="app-header">
  <div class="app-header-icon">&#x1F4CB;</div>
  <div>
    <h1>DoD Banner Library</h1>
    <p>Release Notes</p>
  </div>
</div>

<a class="back-link" href="dodbl_banner-launch-page">&larr; Home</a>

<div class="main">

  <div class="version-block">
    <div class="version-header">
      <span class="version-tag">v1.5.0</span>
      <span class="version-date">2026-08-12</span>
      <span class="version-badge">Latest</span>
    </div>
    <div class="change-group">
      <div class="change-group-title">Highlights</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Environment-variable configuration admin</strong> &mdash; added the <code>dodbl_banner-config</code> web resource in the Management app under <strong>Administration &rarr; Banner Configuration</strong>. Authorized admins can manage banner settings in-environment without opening the maker portal or redeploying.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>New banner environment variables</strong> &mdash; added <code>dodbl_BannerColor</code>, <code>dodbl_BannerLabel</code>, and <code>dodbl_BannerVersion</code> definitions. <code>dodbl_BannerColor</code> accepts an optional hex color override, <code>dodbl_BannerLabel</code> accepts optional display text, and <code>dodbl_BannerVersion</code> is the runtime source for displayed app/documentation version labels.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Full-cycle consent audit delivery</strong> &mdash; includes the v1.4.0 consent audit table, Consent Write role guidance, v1.4.1 reliable audit-write ordering, active-record view fix, and Consent Audit Reader role so managed imports carry the complete consent-audit feature set forward.</span></li>
      </ul>
    </div>
    <div class="change-group">
      <div class="change-group-title">Banner runtime</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Color and label overrides</strong> &mdash; shell bars now honor <code>dodbl_BannerColor</code> for valid hex colors and <code>dodbl_BannerLabel</code> for custom text; empty values continue to use the classification defaults.</span></li>
        <li class="change-item"><span class="change-pill pill-new">FIX</span><span class="change-text"><strong>Friendly classification labels</strong> &mdash; stored short codes such as <code>U</code> display as <code>UNCLASSIFIED</code> in the configuration modal and shell bars, while existing prefix/color matching remains intact.</span></li>
        <li class="change-item"><span class="change-pill pill-new">FIX</span><span class="change-text"><strong>Full-navigation coverage</strong> &mdash; the Model-Driven App shell renderer now installs a global <code>window.top.__dodBanner</code> singleton with a <code>MutationObserver</code> and interval watchdog so full-page navigation and shell re-renders restore the configured classification bar instead of leaving gaps.</span></li>
        <li class="change-item"><span class="change-pill pill-new">FIX</span><span class="change-text"><strong>In-flow shell insertion</strong> &mdash; top bars are inserted before <code>topBar</code> / <code>shell-container</code> when those shell anchors are available, with the previous fixed-position/body insertion and header-shift fallback retained for older layouts.</span></li>
      </ul>
    </div>
    <div class="change-group">
      <div class="change-group-title">Admin experience</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Config Admin role</strong> &mdash; added the <code>DoD Banner - Config Admin</code> security role for the configuration screen. Assign it deliberately because <code>dodbl_BannerType</code>, color, and label are classification-presentation settings.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Consent reset action</strong> &mdash; the configuration screen includes a <strong>Reset My Consent</strong> button that clears only the current user&rsquo;s <code>dodbl_Accepted</code> cookie for retesting.</span></li>
        <li class="change-item"><span class="change-pill pill-remove">REMOVED</span><span class="change-text"><strong>Redundant Apply now button</strong> &mdash; removed the extra Apply action. <strong>Save</strong> now persists the value changes and repaints the visible shell banner in place for the current user.</span></li>
      </ul>
    </div>
    <div class="change-group">
      <div class="change-group-title">Deployment notes</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-note">NOTE</span><span class="change-text"><strong>Environment-variable packaging fix</strong> &mdash; the managed solution now includes the new environment variable definitions so <code>dodbl_BannerColor</code>, <code>dodbl_BannerLabel</code>, and <code>dodbl_BannerVersion</code> import correctly alongside the existing six definitions.</span></li>
        <li class="change-item"><span class="change-pill pill-note">NOTE</span><span class="change-text"><strong>Enable auditing for full change history</strong> &mdash; each configuration save stamps <code>modifiedby</code> and <code>modifiedon</code> on the Environment Variable Value record, which the screen displays. Turn on environment-level auditing and table auditing for Environment Variable Value to retain before/after change history.</span></li>
      </ul>
    </div>
  </div>

  <div class="version-block">
    <div class="version-header">
      <span class="version-tag">v1.4.1</span>
      <span class="version-date">2026-08-11</span>
    </div>
    <div class="change-group">
      <div class="change-group-title">Fixed</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-new">FIX</span><span class="change-text"><strong>Consent audit write ordering</strong> &mdash; consent acknowledgement now reliably records a Consent Record. The acknowledgement cookie is only set after the audit write succeeds, so a failed write no longer suppresses future attempts.</span></li>
        <li class="change-item"><span class="change-pill pill-new">FIX</span><span class="change-text"><strong>Active Consent Records view</strong> &mdash; now shows only active records that are not revoked and not expired, sorted newest-first.</span></li>
      </ul>
    </div>
    <div class="change-group">
      <div class="change-group-title">New</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Consent Audit Reader role</strong> &mdash; added the <code>DoD Banner - Consent Audit Reader</code> read-only security role for least-privilege access to consent audit records.</span></li>
      </ul>
    </div>
  </div>

  <div class="version-block">
    <div class="version-header">
      <span class="version-tag">v1.4.0</span>
      <span class="version-date">2026-08-03</span>
    </div>
    <div class="change-group">
      <div class="change-group-title">New</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Dataverse consent audit table</strong> &mdash; <code>dodbl_consentrecord</code> with columns: <code>dodbl_userid</code> (Lookup), <code>dodbl_acknowledgedon</code>, <code>dodbl_expirydate</code>, <code>dodbl_bannertype</code>, <code>dodbl_consenttext</code>, <code>dodbl_revoked</code>, and <code>dodbl_isactive</code>. Table-level auditing enabled.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Consent Write role assignment</strong> &mdash; assign <code>DoD Banner - Consent Write</code> to every user-facing security role whose users can see the consent banner; otherwise <code>dodbl_consentrecord</code> writes fail with a privilege error.</span></li>
      </ul>
    </div>
    <div class="change-group">
      <div class="change-group-title">Deployment notes</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-note">NOTE</span><span class="change-text"><strong>Breaking migration for existing environments</strong> &mdash; delete and recreate the old Simple Yes/No <code>dodbl_isactive</code> column as the Formula column <code>If(dodbl_expirydate &gt; UTCNow() &amp;&amp; Not(dodbl_revoked), true, false)</code>.</span></li>
        <li class="change-item"><span class="change-pill pill-note">NOTE</span><span class="change-text"><strong>Active Consent Records view</strong> &mdash; filter on stored <code>dodbl_expirydate</code> on or after today, not on <code>dodbl_isactive</code>, because formula columns using <code>UTCNow()</code> have FetchXML/view filtering limitations.</span></li>
      </ul>
    </div>
  </div>

  <div class="version-block">
    <div class="version-header">
      <span class="version-tag">v1.3.0</span>
      <span class="version-date">2026-07-24</span>
    </div>
    <div class="change-group">
      <div class="change-group-title">New</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>dodbl_banner-launch-page</strong> &mdash; Model-Driven App custom home page that presents the DoD consent gate before showing the management app navigation tiles.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Single consent entry point</strong> &mdash; the home-page overlay is now the MDA consent experience; the duplicate shell-level <code>Xrm.App.addGlobalNotification</code> banner was removed to keep the architecture simple and unambiguous.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Configurable consent text</strong> &mdash; the launch page resolves text from a query-string override first, then <code>dodbl_DoDConsentText</code> via <code>Xrm.WebApi</code>, then the built-in DoD warning fallback.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Consent UI polish</strong> &mdash; the page title is now &ldquo;U.S. Government System - Authorized Users Only&rdquo;, the subtitle is &ldquo;DoD Banner Library&rdquo;, and the <strong style="color:#a4262c">WARNING:</strong> label is emphasized in red.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Consent cookie hardening</strong> &mdash; the consent cookie was renamed to <code>dodbl_Accepted</code> and is written with <code>Secure; SameSite=Strict</code>; the acknowledge path now consistently dismisses the overlay and reveals the home content.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Cookie parsing hardening</strong> &mdash; <code>getCookie</code> now splits on the first <code>=</code> before <code>decodeURIComponent</code>, preventing malformed cookie values from throwing <code>URIError</code> (#3).</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>PCF consent re-arm</strong> &mdash; <code>DodBannerControl</code> now resets its consent setup guard when <code>showConsent</code> transitions from off to on so the consent gate can re-arm without a reload (#6).</span></li>
        <li class="change-item"><span class="change-pill pill-note">NOTE</span><span class="change-text"><strong>PCF bundle version</strong> &mdash; the PCF control version was bumped from <code>1.2.0</code> to <code>1.2.1</code> so Canvas apps pick up the updated bundle.</span></li>
      </ul>
    </div>
    <div class="change-group">
      <div class="change-group-title">Known limitation</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-note">NOTE</span><span class="change-text"><strong>Sitemap gate != enforcement</strong> &mdash; the v1.3.0 MDA gate is a UX-level home-page entry pattern, not a hard security boundary. Deep links, global search, pinned items, and recent items can bypass the home page; enforcement is tracked separately in issue #13 and deferred beyond v1.3.0.</span></li>
        <li class="change-item"><span class="change-pill pill-note">NOTE</span><span class="change-text"><strong>Canvas consent persistence</strong> &mdash; consent acknowledgment does not persist across sessions in Canvas apps because of the PCF sandbox; persistent Canvas consent remains tracked separately in issue #21. The Model-Driven App home-page gate persists consent normally, and v1.5.0 adds full-navigation banner/watchdog coverage for the MDA shell.</span></li>
      </ul>
    </div>
  </div>
  <div class="version-block">
    <div class="version-header">
      <span class="version-tag">v1.2.0</span>
      <span class="version-date">2026-07-24</span>
    </div>
    <div class="change-group">
      <div class="change-group-title">New</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>showConsent PCF property</strong> &mdash; New <code>showConsent</code> (TwoOptions) input property on <code>DodBannerControl</code>. Decouples the DoD system-use notification consent modal from <code>bannerType</code>. Set <code>showConsent = true</code> to show the consent modal without a classification bar. Legacy <code>bannerType = "DoD"</code> continues to work.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>CSS injection for Canvas Apps</strong> &mdash; PCF now injects all modal styles directly into <code>document.head</code> (<code>&lt;style data-dodbl-pcf-styles&gt;</code>) at runtime. Canvas Apps and Custom Pages do not load <code>dodbl_bannercore.css</code>, so the bundle is now fully self-contained. Idempotent &mdash; safe across multiple <code>updateView</code> calls.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>DoD placeholder indicator</strong> &mdash; When <code>showConsent = true</code> and no classification bar is configured, the PCF control renders a navy dashed &ldquo;&#x26A0; DoD Consent&rdquo; placeholder so the control is visible in the Canvas App editor. At runtime the full modal and dark overlay appear.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Dark overlay</strong> &mdash; Semi-transparent full-viewport overlay (<code>rgba(0,0,0,0.45)</code>) blocks interaction with the app until the user acknowledges. Renders beneath the modal at <code>z-index: 9997</code>.</span></li>
      </ul>
    </div>
    <div class="change-group">
      <div class="change-group-title">Removed</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-remove">REMOVED</span><span class="change-text"><strong>Close button (&#x00D7;) removed from PCF modal</strong> &mdash; The <code>#closeCookieConsent</code> dismiss-without-acknowledging button has been removed. Users must click <strong>I Acknowledge</strong> to dismiss the DoD system-use notification. This satisfies the DoD requirement for affirmative acknowledgement.</span></li>
      </ul>
    </div>
    <div class="change-group">
      <div class="change-group-title">Fixed</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-new">FIX</span><span class="change-text"><strong>Modal display flash</strong> &mdash; Modal no longer briefly flashes visible before the 800&thinsp;ms delay. The element starts as <code>display:none</code> and is revealed immediately before <code>fadeIn</code> begins.</span></li>
        <li class="change-item"><span class="change-pill pill-new">FIX</span><span class="change-text"><strong>Modal contrast and spacing</strong> &mdash; Increased padding (<code>24px 28px</code>), added border (<code>2px solid #555</code>), and deepened box-shadow for legibility on all background colors.</span></li>
      </ul>
    </div>
  </div>
  <div class="version-block">
    <div class="version-header">
      <span class="version-tag">v1.1.0</span>
      <span class="version-date">2026-07-23</span>
    </div>
    <div class="change-group">
      <div class="change-group-title">New</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>dodbl_dodbanner &mdash; MDA form OnLoad script</strong> &mdash; Reads six <code>dodbl_</code> environment variables via <code>Xrm.WebApi</code>. Handler: <code>DoDBannerLibrary.DodBanner.onFormLoad</code>. No PCF or Premium license required.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Consent via <code>Xrm.App.addGlobalNotification</code></strong> &mdash; DoD system-use notification renders as a native UCI yellow warning bar with &ldquo;I Acknowledge&rdquo; action. Replaces the DOM-injected modal. Persists across form navigation. Requires no <code>window.top</code> access.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>dodbl_ShowConsentBanner</strong> env var (Boolean) &mdash; Decouples consent from the classification bar. Set to <code>yes</code> to show the DoD system-use notification independently of <code>dodbl_BannerType</code>.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>dodbl_BannerPosition</strong> env var (String) &mdash; Controls classification bar placement: <code>Bottom</code> (default), <code>Top</code>, or <code>Both</code>. Top placement shifts the MDA global nav header down 28&thinsp;px to avoid overlap.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Environment variables (6 total)</strong> &mdash; <code>dodbl_BannerEnabled</code>, <code>dodbl_BannerType</code>, <code>dodbl_DoDConsentText</code>, <code>dodbl_ConsentExpiryDays</code>, <code>dodbl_ShowConsentBanner</code>, <code>dodbl_BannerPosition</code>.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>DodBannerControl PCF for Canvas Apps</strong> &mdash; PCF field control providing consent modal and classification bar for Canvas Apps. Requires Power Apps Premium or Managed Environment. Properties: <code>bannerEnabled</code>, <code>bannerType</code>, <code>consentExpiryDays</code>, <code>consentText</code>.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>dodbl_webtemplatesource</strong> &mdash; Power Pages Web Template source page with step-by-step Liquid setup instructions.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>DoD Banner Library Management app</strong> &mdash; Model-driven app providing in-environment access to documentation, release notes, and web template source from the app switcher.</span></li>
      </ul>
    </div>
  </div>

  <div class="version-block">
    <div class="version-header">
      <span class="version-tag">v1.0.0</span>
      <span class="version-date">2026-07-22</span>
    </div>
    <div class="change-group">
      <div class="change-group-title">New</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>banner-core.css</strong> &mdash; shared stylesheet combining DoD consent modal responsive layout (3 breakpoints) and CUI classification mark color rules for all five levels.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>dod-consent-banner.html</strong> &mdash; DoD system-use notification consent modal. Vanilla JavaScript, no external dependencies. GCC High / IL4/IL5 safe.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>cui-consent-banner.html</strong> &mdash; CUI classification mark banner fragment. CSS-only, no JavaScript required. Supports top (<code>.classification-banner</code>) and bottom (<code>.classification-banner-bot</code>) placement via <code>data-classification</code> attribute.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Solution packaging</strong> &mdash; all assets packaged as a managed Power Platform solution (<code>dod_banner_library</code>) with publisher prefix <code>dodbl</code>. Supports GCC High tenant import.</span></li>
        <li class="change-item"><span class="change-pill pill-new">NEW</span><span class="change-text"><strong>Documentation web resources</strong> &mdash; <code>dodbl_docs</code> and <code>dodbl_release-notes</code> included in the solution for in-environment reference.</span></li>
      </ul>
    </div>
    <div class="change-group">
      <div class="change-group-title">Removed</div>
      <ul class="change-list">
        <li class="change-item"><span class="change-pill pill-remove">REMOVED</span><span class="change-text"><strong>jQuery CDN dependency</strong> &mdash; the <code>jquery-3.7.1.js</code> CDN script tag was removed from the consent banner. All jQuery calls replaced with vanilla JavaScript equivalents. No behavior change for end users.</span></li>
        <li class="change-item"><span class="change-pill pill-remove">REMOVED</span><span class="change-text"><strong>Inline <code>&lt;style&gt;</code> blocks</strong> &mdash; CSS extracted from both HTML files and consolidated into <code>banner-core.css</code> to enable a single web resource upload for all platforms.</span></li>
      </ul>
    </div>
  </div>

</div>
<script>
"use strict";

// ── Shared shell classification bar runtime ─────────────────────────────────
// Each web resource can seed this window.top singleton after a browser reload.
function getDodBannerRuntime() {
  var target;
  try { target = (window.top && window.top.document) ? window.top : window; }
  catch (_e) { target = window; }

  if (target.__dodBanner && typeof target.__dodBanner.install === "function") {
    return target.__dodBanner.install(window);
  }

  var state = {
    clientWindow: window,
    observer: null,
    observedBody: null,
    intervalId: null,
    debounceId: null,
    lastState: null,
    refreshPromise: null
  };

  var BANNER_TYPE_DEFAULT = "";
  var SCHEMAS = [
    "dodbl_BannerEnabled",
    "dodbl_BannerType",
    "dodbl_BannerColor",
    "dodbl_BannerLabel",
    "dodbl_BannerVersion",
    "dodbl_BannerPosition",
    "dodbl_ConsentExpiryDays",
    "dodbl_DoDConsentText",
    "dodbl_ShowConsentBanner"
  ];

  function getDoc() {
    try { return (target && target.document) ? target.document : document; }
    catch (_e) { return document; }
  }

  function getClientXrm() {
    var client = state.clientWindow || window;
    try { if (client.parent && client.parent.Xrm) return client.parent.Xrm; } catch (_e1) { /* ignore */ }
    try { if (client.Xrm) return client.Xrm; } catch (_e2) { /* ignore */ }
    try { if (target && target.Xrm) return target.Xrm; } catch (_e3) { /* ignore */ }
    try { if (parent && parent.Xrm) return parent.Xrm; } catch (_e4) { /* ignore */ }
    return null;
  }

  function getBannerEnabledValue(value) {
    return String(value == null ? "yes" : value).trim().toLowerCase() || "yes";
  }

  function isBannerEnabled(value) {
    var enabled = getBannerEnabledValue(value);
    return !(enabled === "no" || enabled === "false" || enabled === "0");
  }

  function isBannerDebugEnabled() {
    try {
      var storage = (target && target.localStorage) ? target.localStorage : window.localStorage;
      return storage && storage.getItem("dodbl_debugBanner") === "true";
    } catch (_e) {
      return false;
    }
  }

  function logBannerDebug(vars) {
    if (!isBannerDebugEnabled() || !window.console || !console.log) return;
    console.log("[DoDBannerLibrary] classification bar env", {
      vars: vars,
      enabled: getBannerEnabledValue(vars && vars["dodbl_BannerEnabled"]),
      willRender: isBannerEnabled(vars && vars["dodbl_BannerEnabled"])
    });
  }

  function getClassificationColor(bannerType) {
    var t = (bannerType || "").toUpperCase();
    if (t.indexOf("CU") === 0) return "#5a04b0";
    if (t.indexOf("U")  === 0) return "#5cb85c";
    if (t.indexOf("CO") === 0) return "#286090";
    if (t.indexOf("S")  === 0) return "#d9534f";
    if (t.indexOf("T")  === 0) return "#f0ad4e";
    return "#5e5e5e";
  }

  function isValidHex(value) {
    return /^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(((value || "") + "").trim());
  }

  function normalizeHexColor(value) {
    var color = ((value || "") + "").trim();
    return isValidHex(color) ? color : "";
  }

  function getContrastTextColor(hexColor) {
    var color = normalizeHexColor(hexColor);
    if (!color) return "#fff";
    var h = color.substring(1);
    if (h.length === 3) h = h.charAt(0) + h.charAt(0) + h.charAt(1) + h.charAt(1) + h.charAt(2) + h.charAt(2);
    var r = parseInt(h.substring(0, 2), 16);
    var g = parseInt(h.substring(2, 4), 16);
    var b = parseInt(h.substring(4, 6), 16);
    return ((r * 299 + g * 587 + b * 114) / 1000) > 160 ? "#000" : "#fff";
  }

  function getClassificationLabel(bannerType) {
    var t = (bannerType || "").toUpperCase();
    if (t.indexOf("CU") === 0) return "CUI";
    if (t.indexOf("U")  === 0) return "UNCLASSIFIED";
    if (t.indexOf("CO") === 0) return "CONFIDENTIAL";
    if (t.indexOf("S")  === 0) return "SECRET";
    if (t.indexOf("T")  === 0) return "TOP SECRET";
    if (t.indexOf("DOD") === 0) return "DOD";
    return t;
  }

  function restoreShiftedHeader(doc) {
    var shiftedHeader = doc.querySelector("[data-dodbl-shifted]");
    if (!shiftedHeader) return;
    try {
      var saved = JSON.parse(shiftedHeader.getAttribute("data-dodbl-shifted"));
      shiftedHeader.style.top = saved.top || "";
      shiftedHeader.style.marginTop = saved.marginTop || "";
    } catch (_e) {
      shiftedHeader.style.top = shiftedHeader.style.marginTop = "";
    }
    shiftedHeader.removeAttribute("data-dodbl-shifted");
  }

  function removeClassificationBars() {
    var doc = getDoc();
    if (!doc || !doc.querySelectorAll) return;
    restoreShiftedHeader(doc);
    doc.querySelectorAll("[data-dodbl-bar]").forEach(function (el) {
      if (el.parentNode) el.parentNode.removeChild(el);
    });
  }

  function normalizeState(input) {
    var vars = input || {};
    var bannerType = ((vars["dodbl_BannerType"] || BANNER_TYPE_DEFAULT) + "").trim();
    return {
      vars: vars,
      enabled: isBannerEnabled(vars["dodbl_BannerEnabled"]),
      bannerType: bannerType,
      bannerColor: ((vars["dodbl_BannerColor"] || "") + "").trim(),
      bannerLabel: ((vars["dodbl_BannerLabel"] || "") + "").trim(),
      bannerVersion: ((vars["dodbl_BannerVersion"] || "") + "").trim(),
      position: ((vars["dodbl_BannerPosition"] || "Bottom") + "").trim()
    };
  }

  function render(input) {
    var doc = getDoc();
    var body = doc && doc.body;
    var next = input && input.vars ? input : normalizeState(input);
    state.lastState = next;
    logBannerDebug(next.vars || {});
    if (!body) return next;

    if (!next.enabled || !next.bannerType) {
      removeClassificationBars();
      return next;
    }

    var BAR_HEIGHT = 28;
    removeClassificationBars();

    var pos = (next.position || "bottom").toLowerCase();
    var validOverrideColor = next.bannerColor && isValidHex(next.bannerColor);
    var color = validOverrideColor ? next.bannerColor : getClassificationColor(next.bannerType);
    var textColor = validOverrideColor ? getContrastTextColor(next.bannerColor) : "#fff";
    var label = next.bannerLabel || getClassificationLabel(next.bannerType);

    function buildBar(placement, inFlow) {
      var bar = doc.createElement("div");
      bar.id = placement === "top" ? "dodbl-classification-bar-top" : "dodbl-classification-bar-bottom";
      bar.setAttribute("data-dodbl-bar", placement);
      bar.setAttribute("data-dodbl-bar-mode", inFlow ? "in-flow" : "fixed");
      bar.textContent = label;
      bar.style.position = inFlow ? "relative" : "fixed";
      bar.style.left = inFlow ? "" : "0";
      bar.style.width = "100%";
      bar.style.height = BAR_HEIGHT + "px";
      bar.style.backgroundColor = color;
      bar.style.color = textColor;
      bar.style.fontWeight = "bold";
      bar.style.fontFamily = '\"Segoe UI\",Tahoma,Geneva,Verdana,sans-serif';
      bar.style.fontSize = "14px";
      bar.style.display = "flex";
      bar.style.alignItems = "center";
      bar.style.justifyContent = "center";
      bar.style.letterSpacing = "0.06em";
      bar.style.textShadow = "1px 1px 0 rgba(0,0,0,.3)";
      bar.style.zIndex = "9999";
      bar.style.boxSizing = "border-box";
      bar.style.pointerEvents = "none";
      if (placement === "top" && !inFlow) bar.style.top = "0";
      else if (placement === "bottom") bar.style.bottom = "0";
      return bar;
    }

    function insertTopBar() {
      var shell = doc.getElementById("topBar") || doc.getElementById("shell-container");
      if (shell && shell.parentElement) {
        shell.parentElement.insertBefore(buildBar("top", true), shell);
        return true;
      }
      body.insertBefore(buildBar("top", false), body.firstChild);
      return false;
    }

    function shiftMdaHeader() {
      var win = target || window;
      var vw = win.innerWidth || 800;
      var sels = ["[role='banner']", "[data-id='navbar']", ".pa-n-w", ".pa-navbar", "header"];
      var header = null;
      for (var si = 0; si < sels.length; si++) {
        var el = doc.querySelector(sels[si]);
        if (!el) continue;
        var r = el.getBoundingClientRect();
        if (r.top <= 10 && r.width >= vw * 0.5) { header = el; break; }
      }
      if (!header || header.hasAttribute("data-dodbl-shifted")) return;

      header.setAttribute("data-dodbl-shifted", JSON.stringify({
        top: header.style.top,
        marginTop: header.style.marginTop
      }));

      var cs = win.getComputedStyle(header);
      if (cs.position === "fixed" || cs.position === "sticky" || cs.position === "absolute") {
        header.style.top = (parseInt(cs.top, 10) || 0) + BAR_HEIGHT + "px";
      } else {
        header.style.marginTop = (parseInt(cs.marginTop, 10) || 0) + BAR_HEIGHT + "px";
      }
    }

    if (pos === "both") {
      var topInsertedInFlow = insertTopBar();
      body.appendChild(buildBar("bottom", false));
      if (!topInsertedInFlow) {
        shiftMdaHeader();
        target.setTimeout(shiftMdaHeader, 800);
      }
    } else if (pos === "top") {
      if (!insertTopBar()) {
        shiftMdaHeader();
        target.setTimeout(shiftMdaHeader, 800);
      }
    } else {
      body.appendChild(buildBar("bottom", false));
    }

    return next;
  }

  function expectedPlacements() {
    if (!state.lastState || !state.lastState.enabled || !state.lastState.bannerType) return [];
    var pos = (state.lastState.position || "bottom").toLowerCase();
    return pos === "both" ? ["top", "bottom"] : [pos === "top" ? "top" : "bottom"];
  }

  function ensureBarPresent() {
    var doc = getDoc();
    if (!doc || !doc.body) return;
    connectObserver();
    var placements = expectedPlacements();
    if (placements.length === 0) return;
    for (var i = 0; i < placements.length; i++) {
      var placement = placements[i];
      var bar = doc.querySelector('[data-dodbl-bar="' + placement + '"]');
      if (!bar) {
        render(state.lastState);
        return;
      }
      if (placement === "top") {
        var shell = doc.getElementById("topBar") || doc.getElementById("shell-container");
        var shouldBeInFlow = !!(shell && shell.parentElement);
        var isInFlow = bar.getAttribute("data-dodbl-bar-mode") === "in-flow";
        var isBeforeShell = shouldBeInFlow && bar.parentElement === shell.parentElement && bar.nextSibling === shell;
        if ((shouldBeInFlow && (!isInFlow || !isBeforeShell)) || (!shouldBeInFlow && isInFlow)) {
          render(state.lastState);
          return;
        }
      }
    }
  }

  function scheduleEnsure() {
    if (state.debounceId) target.clearTimeout(state.debounceId);
    state.debounceId = target.setTimeout(function () {
      state.debounceId = null;
      ensureBarPresent();
    }, 250);
  }

  function connectObserver() {
    var doc = getDoc();
    if (!doc || !doc.body || typeof target.MutationObserver !== "function") return;
    if (state.observer && state.observedBody === doc.body) return;
    if (state.observer) state.observer.disconnect();
    state.observer = new target.MutationObserver(scheduleEnsure);
    state.observer.observe(doc.body, { childList: true, subtree: true });
    state.observedBody = doc.body;
  }

  function installWatchdog() {
    connectObserver();
    if (!state.intervalId) {
      state.intervalId = target.setInterval(ensureBarPresent, 15000);
    }
  }

  function getEnvVars() {
    var xrm = getClientXrm();
    if (!(xrm && xrm.WebApi)) return Promise.reject(new Error("Xrm.WebApi unavailable for banner refresh."));

    var schemaFilter = SCHEMAS
      .map(function (s) { return "schemaname eq '" + s + "'"; })
      .join(" or ");

    return xrm.WebApi.retrieveMultipleRecords(
      "environmentvariabledefinition",
      "?$select=environmentvariabledefinitionid,schemaname,defaultvalue&$filter=" + schemaFilter
    ).then(function (defResult) {
      var defMap = {};
      (defResult.entities || []).forEach(function (def) {
        defMap[def.environmentvariabledefinitionid] = {
          schemaname: def.schemaname,
          resolvedValue: def.defaultvalue
        };
      });

      var defIds = Object.keys(defMap);
      if (defIds.length === 0) return {};

      var valFilter = defIds
        .map(function (id) { return "_environmentvariabledefinitionid_value eq " + id; })
        .join(" or ");

      return xrm.WebApi.retrieveMultipleRecords(
        "environmentvariablevalue",
        "?$select=value,_environmentvariabledefinitionid_value&$filter=" + valFilter
      ).then(function (valResult) {
        (valResult.entities || []).forEach(function (val) {
          var defId = val["_environmentvariabledefinitionid_value"];
          if (defMap[defId] && val.value != null && String(val.value).trim() !== "") {
            defMap[defId].resolvedValue = val.value;
          }
        });

        var vars = {};
        Object.keys(defMap).forEach(function (id) {
          vars[defMap[id].schemaname] = defMap[id].resolvedValue;
        });
        return vars;
      });
    });
  }

  var api = {
    install: function (clientWindow) {
      state.clientWindow = clientWindow || state.clientWindow || window;
      installWatchdog();
      target.dodblRenderClassificationBar = api.refresh;
      return api;
    },
    refresh: function () {
      if (state.refreshPromise) return state.refreshPromise;
      state.refreshPromise = getEnvVars()
        .then(function (vars) {
          render(vars || {});
          state.refreshPromise = null;
          return vars || {};
        }, function (error) {
          state.refreshPromise = null;
          throw error;
        });
      return state.refreshPromise;
    },
    render: render,
    remove: removeClassificationBars
  };

  target.__dodBanner = api;
  return api.install(window);
}

getDodBannerRuntime().refresh();
</script>
